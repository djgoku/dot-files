/// Fast per-PR checks. Only project tools are installed: this job checks repo
/// formatting and syntax, proves the mise config and bootstrap stages resolve,
/// and confirms generated workflow YAML matches its Pkl source.
///
/// Regenerate the YAML with `mise run render-workflows` -- never hand-edit
/// the .yml.
amends "@com.github.actions/Workflow.pkl"

name = "Validate"

on {
  push { branches { "main" } }
  pull_request {}
  workflow_dispatch = new {}
}

permissions { contents = "read" }

// Packslip release discovery uses the GitHub API. The default token avoids
// unauthenticated rate limits on shared runner IPs and needs no extra
// permissions beyond the contents:read declared above.
env {
  // com.github.actions.context exposes no `secrets`, so this is the literal
  // expression; `$` is not special in a Pkl string.
  ["GITHUB_TOKEN"] = "${{ secrets.GITHUB_TOKEN }}"
}

concurrency {
  group = "\(module.context.github.workflow)-\(module.context.github.ref)"
  `cancel-in-progress` = true
}

jobs {
  ["validate"] {
    // macOS, not ubuntu: the config is macOS-specific (Terminal.plist,
    // bootstrap.macos.*), so validating it anywhere else proves little.
    `runs-on` = "macos-latest"
    `timeout-minutes` = 15
    steps {
      new { uses = "actions/checkout@v6" }

      new {
        name = "Install mise"
        run = "curl -fsSL https://mise.run | sh"
      }

      // Runs before the machine config is linked so only the project config is
      // in scope -- otherwise `mise install` would pull Emacs and conda too.
      new {
        name = "Install project tools"
        run =
          """
          ~/.local/bin/mise trust --yes
          ~/.local/bin/mise install
          """
      }

      new {
        name = "Repository checks"
        run = "~/.local/bin/mise exec -- hk check --all"
      }

      // Runs the real setup.sh rather than reimplementing its linking --
      // when the two diverged, this job created a ~/.dot-files that setup.sh
      // did not, so the dry-run passed while a real bootstrap failed.
      // --prepare-only stops before the expensive `mise bootstrap`.
      new {
        name = "Prepare, via the real setup.sh"
        run =
          """
          mkdir -p ~/dev/github/djgoku
          ln -sfn "$GITHUB_WORKSPACE" ~/dev/github/djgoku/dot-files
          ./setup.sh --no-clone --prepare-only
          """
      }

      // Catches the failure that started all this: config sitting somewhere
      // mise never reads. Five files must load.
      new {
        name = "Machine config loads"
        run =
          """
          ~/.local/bin/mise config ls
          test "$(~/.local/bin/mise config ls --no-header | grep -c 'config/mise')" = "5"
          """
      }

      new {
        name = "Every bootstrap stage resolves"
        run = "~/.local/bin/mise bootstrap --dry-run"
      }

      // bootstrap --dry-run does not resolve remote tool releases. On a cold
      // runner this checks Packslip discovery without installing Emacs or
      // changing the lockfile. The release-age override covers a newly
      // published first release that would otherwise produce an empty list.
      new {
        name = "Packslip Emacs release is discoverable"
        run =
          """
          versions="$(~/.local/bin/mise ls-remote --minimum-release-age 0s 'packslip:github.com/djgoku/misemacs-emacs-master')"
          test -n "$versions"
          """
      }
    }
  }
}
